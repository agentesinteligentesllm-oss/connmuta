{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "../../dist",
    "tsBuildInfoFile": "../../dist/.tsbuildinfo/cli.tsbuildinfo"
  },
  "include": ["**/*.ts"],
  // `../client` and `../daemon` are deliberately absent until their first `.ts` lands (PR-32 and
  // PR-15): a referenced composite project with no inputs is TS18003, and `npm run build` builds
  // every project this one references. Re-add each `{ "path": ... }` in the slice that writes its
  // first source file (HANDOFF §4 "src/cli/ must join the root references").
  "references": [{ "path": "../shared" }]
}
