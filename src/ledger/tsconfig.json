{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "../../dist",
    "tsBuildInfoFile": "../../dist/.tsbuildinfo/ledger.tsbuildinfo"
  },
  "include": ["**/*.ts"],
  // `../shared` lands here with the first module of this unit that uses a shared constant:
  // `migrations.ts` reads `LEDGER_SCHEMA_VERSION` (PR-11). That is not a compiler constraint — measured
  // with this repository's TypeScript 7.0.2, a composite unit that carries a project reference and imports
  // nothing from it builds clean (exit 0), and so does a composite unit whose directory holds only its
  // `tsconfig.json`. TS18003 ("No inputs were found in config file") is what an *empty non-composite* unit
  // reports, not what a reference produces. The reference lands with the import because it was not needed
  // before it. (Two earlier versions of this note were false and Judgment Day measured both: an empty
  // *referencing* unit is not TS18003, and a unit's `tsconfig.json` can exist before its first `.ts` file.)
  "references": [{ "path": "../shared" }]
}
