{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "../../dist",
    "tsBuildInfoFile": "../../dist/.tsbuildinfo/ledger.tsbuildinfo"
  },
  "include": ["**/*.ts"]
  // This unit references no other unit yet, and that is a property of these two modules rather than an
  // omission: `schema.ts` is the DDL text and `transaction.ts` imports `node:sqlite`'s type only. The
  // slice that first needs a shared constant — `ledger/open.ts` reads `LEDGER_SCHEMA_VERSION` (PR-11) —
  // adds `{ "path": "../shared" }` here. An empty *referencing* unit is TS18003, so that reference
  // lands with the first `.ts` file that uses it (HANDOFF §4).
}
