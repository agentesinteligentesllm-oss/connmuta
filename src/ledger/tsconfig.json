{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "../../dist",
    "tsBuildInfoFile": "../../dist/.tsbuildinfo/ledger.tsbuildinfo"
  },
  "include": ["**/*.ts"],
  // `../shared` lands here with the first module of this unit that uses a shared constant:
  // `migrations.ts` reads `LEDGER_SCHEMA_VERSION` (PR-11). An empty *referencing* unit is TS18003, so
  // the reference could not arrive before that import did (PR-09a disclosed the same omission).
  "references": [{ "path": "../shared" }]
}
