    "test:wrong-room": "tsc -b && node --test \"dist/test/security/*wrong-room*\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.6.5",
    "@napi-rs/keyring": "2.1.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "24.13.5"
  }
}
